# ==============================================================================
# MediFind Environment Configuration Template (.env.example)
# Copy this file to .env and populate with your environment-specific credentials.
# NEVER commit real production secrets or .env to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DJANGO SETTINGS
# ------------------------------------------------------------------------------
# Set to 'False' in production. Set to 'True' ONLY during local development.
DEBUG=False

# A cryptographically secure, random 50+ character string.
# Generate in Python using: python -c "import secrets; print(secrets.token_urlsafe(55))"
SECRET_KEY=replace-with-a-secure-50-character-secret-key-in-production

# Comma-separated list of valid host/domain names that this Django site can serve.
# In production, specify your custom domain and platform domain (e.g., medifind.onrender.com).
ALLOWED_HOSTS=localhost,127.0.0.1,medifind.onrender.com

# Comma-separated list of trusted origins for CSRF protection on HTTPS (Django 4.0+ / 5.0+).
# Must include scheme (https:// or http://).
CSRF_TRUSTED_ORIGINS=https://medifind.onrender.com,http://localhost:8000,http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# In production, provide the PostgreSQL connection URI provided by your cloud host.
# Example: postgres://USER:PASSWORD@HOST:PORT/DATABASE_NAME
# Leave blank or commented out to use the local SQLite database (db.sqlite3) during development.
DATABASE_URL=postgres://medifind_user:mypassword@localhost:5432/medifind

# ------------------------------------------------------------------------------
# 3. SSL / HTTPS SECURITY HEADERS
# ------------------------------------------------------------------------------
# Set to 'True' in production to force all HTTP traffic to redirect to HTTPS.
SECURE_SSL_REDIRECT=True

# HTTP Strict Transport Security (HSTS) duration in seconds (31536000 = 1 year).
SECURE_HSTS_SECONDS=31536000

# ------------------------------------------------------------------------------
# 4. EMAIL SERVICE CONFIGURATION (Optional in development)
# ------------------------------------------------------------------------------
# In production, configure an SMTP provider (SendGrid, Mailgun, AWS SES, Gmail SMTP).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your-sendgrid-api-key
# DEFAULT_FROM_EMAIL=notifications@medifind.com
